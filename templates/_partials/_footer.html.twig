    <style>

        /* ==========================================
           FOOTER
        ========================================== */

        .taskflow-footer,
        .taskflow-footer * {
            box-sizing: border-box;
        }

        .taskflow-footer {
            width: 100%;
            padding: 0;

            background: #ffffff;

            border-top: 1px solid #ececec;

            font-family: 'Poppins', sans-serif;
        }


        .footer-container {
            width: 100%;
            max-width: 1200px;

            margin: 0 auto;

            padding:
                28px 32px
                18px;
        }


        /* ==========================================
           TOP
        ========================================== */

        .footer-top {
            display: flex;

            align-items: flex-start;
            justify-content: space-between;

            gap: 50px;

            padding-bottom: 30px;
        }



        /* ==========================================
           BRAND
        ========================================== */

        .footer-brand {
            max-width: 310px;
        }


        .footer-logo {
            margin-bottom: 10px;

            color: #111;

            font-size: 19px;
            font-weight: 600;

            letter-spacing: -0.8px;
        }


        .footer-description {
            margin: 0;

            color: #858585;

            font-size: 12px;
            font-weight: 400;

            line-height: 1.7;
        }



        /* ==========================================
           LINKS
        ========================================== */

        .footer-navigation {
            display: flex;

            gap: 55px;
        }


        .footer-column {
            display: flex;
            flex-direction: column;

            gap: 9px;
        }


        .footer-title {
            margin-bottom: 4px;

            color: #111;

            font-size: 12px;
            font-weight: 600;
        }


        .footer-link {
            width: fit-content;

            position: relative;

            color: #828282;

            font-size: 12px;
            font-weight: 400;

            text-decoration: none;

            transition:
                color .25s ease,
                transform .25s
                cubic-bezier(.16,1,.3,1);
        }


        .footer-link:hover {
            color: #111;

            text-decoration: none;

            transform:
                translateX(2px);
        }



        /* ==========================================
           PETITE LIGNE ANIMÉE AU HOVER
        ========================================== */

        .footer-link::after {
            content: "";

            position: absolute;

            left: 0;
            bottom: -2px;

            width: 100%;
            height: 1px;

            background: #111;

            transform:
                scaleX(0);

            transform-origin:
                right;

            transition:
                transform .35s
                cubic-bezier(.16,1,.3,1);
        }


        .footer-link:hover::after {

            transform:
                scaleX(1);

            transform-origin:
                left;

        }



        /* ==========================================
           DIVIDER
        ========================================== */

        .footer-divider {
            width: 100%;
            height: 1px;

            background:
                #eeeeee;
        }



        /* ==========================================
           BOTTOM
        ========================================== */

        .footer-bottom {
            display: flex;

            align-items: center;
            justify-content: space-between;

            padding-top: 17px;

            gap: 20px;
        }


        .footer-copyright {
            margin: 0;

            color: #999;

            font-size: 11px;
            font-weight: 400;
        }



        /* ==========================================
           STATUS
        ========================================== */

        .footer-status {
            display: flex;

            align-items: center;

            gap: 7px;

            color: #777;

            font-size: 11px;
            font-weight: 500;
        }


        .footer-status-dot {
            width: 7px;
            height: 7px;

            border-radius: 50%;

            background: #111;

            box-shadow:
                0 0 0 3px
                rgba(0,0,0,0.05);
        }



        /* ==========================================
           MOBILE
        ========================================== */

        @media (max-width: 680px) {

            .footer-container {
                padding:
                    24px 22px
                    17px;
            }


            .footer-top {
                flex-direction: column;

                gap: 30px;
            }


            .footer-navigation {
                width: 100%;

                justify-content:
                    space-between;

                gap: 30px;
            }


            .footer-bottom {
                flex-direction: column;

                align-items:
                    flex-start;

                gap: 10px;
            }

        }

    </style>



    <footer class="taskflow-footer">

        <div class="footer-container">


            <!-- ==============================
                 HAUT
            =============================== -->

            <div class="footer-top">


                <!-- BRAND -->

                <div class="footer-brand">

                    <div class="footer-logo">
                        TASKFLOW
                    </div>

                    <p class="footer-description">
                        Organisez votre travail,
                        gérez vos tâches et restez
                        concentré sur ce qui compte
                        vraiment.
                    </p>

                </div>



                <!-- NAVIGATION -->

                <div class="footer-navigation">


                    <div class="footer-column">

                    <span class="footer-title">
                        Navigation
                    </span>


                        <a
                            href="/"
                            class="footer-link"
                        >
                            Accueil
                        </a>


                        <a
                            href="/about"
                            class="footer-link"
                        >
                            À propos
                        </a>

                    </div>



                    <div class="footer-column">

                    <span class="footer-title">
                        Compte
                    </span>


                        <a
                            href="/login"
                            class="footer-link"
                        >
                            Login
                        </a>


                        <a
                            href="/register"
                            class="footer-link"
                        >
                            Register
                        </a>

                    </div>



                    <div class="footer-column">

                    <span class="footer-title">
                        Légal
                    </span>


                        <a
                            href="/privacy"
                            class="footer-link"
                        >
                            Confidentialité
                        </a>


                        <a
                            href="/terms"
                            class="footer-link"
                        >
                            Conditions
                        </a>

                    </div>


                </div>


            </div>



            <!-- DIVIDER -->

            <div class="footer-divider"></div>



            <!-- ==============================
                 BAS
            =============================== -->

            <div class="footer-bottom">


                <p class="footer-copyright">

                    © {{ "now"|date("Y") }}
                    TaskFlow. Tous droits réservés.

                </p>



                <div class="footer-status">

                <span
                    class="footer-status-dot"
                ></span>

                    Tous les systèmes opérationnels

                </div>


            </div>


        </div>

    </footer>
